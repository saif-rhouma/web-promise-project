<!DOCTYPE html>

<html lang="en">
<%~ include('./partials/admin.head.eta') %>

  <body>
    <!-- LOADING AREA START ===== -->
    <div class="loading-area">
      <div class="loading-box"></div>
      <div class="loading-pic">
        <div class="wrapper">
          <div class="cssload-loader"></div>
        </div>
      </div>
    </div>
    <!-- LOADING AREA  END ====== -->

    <div class="page-wraper">
      <%~ include('./partials/admin.sidebar.eta') %>

        <!-- Page Content Holder -->
        <div id="content">
          <div class="content-admin-main">
            <div class="twm-dash-b-blocks mb-5">
              <div class="row">
                <div class="col-xl-4 col-lg-6 col-md-12 mb-3">
                  <div class="panel panel-default">
                    <div class="panel-body wt-panel-body gradi-1 dashboard-card">
                      <div class="wt-card-wrap">
                        <div class="wt-card-icon"><i class="far fa-address-book"></i></div>
                        <div class="wt-card-right wt-total-active-listing counter">
                          <%= it.stats.totalUsers %>
                        </div>
                        <div class="wt-card-bottom">
                          <h4 class="m-b0">Total Users</h4>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-xl-4 col-lg-6 col-md-12 mb-3">
                  <div class="panel panel-default">
                    <div class="panel-body wt-panel-body gradi-2 dashboard-card">
                      <div class="wt-card-wrap">
                        <div class="wt-card-icon"><i class="far fa-file-alt"></i></div>
                        <div class="wt-card-right wt-total-listing-view counter">
                          <%= it.stats.totalStartups %>
                        </div>
                        <div class="wt-card-bottom">
                          <h4 class="m-b0">Startups</h4>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-xl-4 col-lg-6 col-md-12 mb-3">
                  <div class="panel panel-default">
                    <div class="panel-body wt-panel-body gradi-3 dashboard-card">
                      <div class="wt-card-wrap">
                        <div class="wt-card-icon"><i class="far fa-envelope"></i></div>
                        <div class="wt-card-right wt-total-listing-review counter">
                          <%= it.stats.totalEnterprises %>
                        </div>
                        <div class="wt-card-bottom">
                          <h4 class="m-b0">Enterprises</h4>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-lg-12 col-md-12 mb-4">
              <div class="panel panel-default site-bg-white m-t30">
                <div class="panel-heading wt-panel-heading p-a20">
                  <h4 class="panel-tittle m-a0"><i class="far fa-list-alt"></i>All Accounts</h4>
                </div>
                <div class="panel-body wt-panel-body">
                  <div class="twm-D_table p-a20 table-responsive">
                    <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
                    <table id="candidate_data_table" class="table table-bordered">
                      <thead>
                        <tr>
                          <th>Name</th>
                          <th>Sector</th>
                          <th>Type</th>
                          <th>Creation Date</th>
                          <th>Status</th>
                          <th></th>
                        </tr>
                      </thead>
                      <tbody>

                        <% it.users.forEach(us=> { %>
                          <tr>
                            <td>
                              <div class="twm-DT-candidates-list">
                                <div class="twm-media">
                                  <div class="twm-media-pic">
                                    <img src="/images/<%= us.startupProfile.avatar || '/images/default-cover.jpg' %>"
                                      alt="cover" />
                                  </div>
                                </div>
                                <div class="twm-mid-content">
                                  <a href="#" class="twm-job-title">
                                    <h4>
                                      <%= us.startupProfile.name %>
                                    </h4>
                                    <p class="twm-candidate-address">
                                      <i class="feather-map-pin"></i>
                                      <%= us.startupProfile.adress %>
                                    </p>
                                  </a>

                                </div>

                              </div>
                            </td>

                            <td>
                              <span>
                                <%= us.startupProfile.sector %>
                              </span>
                            </td>
                            <td>
                              <div class="twm-jobs-category">
                                <% const typeColors={ 'STARTUP' : 'twm-bg-sky' , 'ENTERPRISE' : 'twm-bg-purple' }; %>

                                  <span class="<%= typeColors[us?.type] || 'text-clr-default' %>">
                                    <%= us?.type || 'N/A' %>
                                  </span>

                              </div>
                            </td>
                            <td>
                              <%= new Date(us.createdAt).toLocaleDateString() %>
                            </td>
                            <td>
                              <div class="twm-jobs-category">
                                <% const statusColors={ 'ACTIVE' : 'twm-bg-green' , 'PENDING' : 'twm-bg-golden'
                                  , 'BLOCKED' : 'twm-bg-red' }; %>
                                  <span class="<%= statusColors[us?.status] || 'text-clr-default' %> status-badge">
                                    <%= us?.status || 'N/A' %>
                                  </span>
                              </div>
                            </td>
                            <td>
                              <div class="twm-table-controls">
                                <ul class="twm-DT-controls-icon list-unstyled">
                                  <li>
                                    <a title="Detail" data-bs-toggle="tooltip" data-bs-placement="top"
                                      href="/startups/<%= us.startupProfile.id %>" target="_blank">
                                      <span class="fa fa-eye"></span>
                                    </a>
                                  </li>
                                  <li>
                                    <button type="button" title="<%~ us.status === 'ACTIVE' ? 'Block':'Activate' %>"
                                      data-bs-toggle="tooltip" data-bs-placement="top" data-id="<%= us.id %>"
                                      data-status="<%= us.status %>" class="toggle-status">
                                      <span class="<%~ us.status === 'ACTIVE' ? 'fa fa-ban':'fa fa-check'%>"></span>
                                    </button>
                                  </li>
                                  <li>
                                  <li>
                                    <button type="button" title="Reset Password"  data-id="<%= us.id %>"
                                      data-name="<%= us.startupProfile.name %>" data-bs-toggle="tooltip"
                                      data-bs-placement="top">
                                      <span class="fa fa-key"></span>
                                    </button>
                                  </li>
                                  <li>
                                    <button type="button" title="Delete" class="delete-user" data-id="<%= us.id %>"
                                      data-name="<%= us.startupProfile.name %>" data-bs-toggle="tooltip"
                                      data-bs-placement="top">
                                      <span class="far fa-trash-alt"></span>
                                    </button>
                                  </li>
                                  </li>
                                </ul>
                              </div>
                            </td>
                          </tr>
                          <% }) %>
                      </tbody>
                      <tfoot>
                        <tr>
                          <th>Name</th>
                          <th>Sector</th>
                          <th>Type</th>
                          <th>Creation Date</th>
                          <th>Status</th>
                          <th></th>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                </div>
              </div>
            </div>

          </div>

        </div>
    </div>

    <%~ include('./partials/admin.model.eta') %>

                  <!--Logout Profile Popup-->
            <%~ include('./partials/admin.logout.model.eta') %>
      </div>

      <div class="modal fade twm-model-popup" id="deleteUserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">

            <div class="modal-header">
              <h5 class="modal-title">Delete User</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
              Are you sure you want to delete
              <strong id="delete-user-name"></strong> ?
            </div>

            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                Cancel
              </button>

              <button type="button" class="btn btn-danger" id="confirm-delete-user">
                Delete
              </button>
            </div>

          </div>
        </div>
      </div>

      <%~ include('./partials/admin.scripts.eta') %>
        <script src="/js/admin-func.js"></script>
  </body>

</html>