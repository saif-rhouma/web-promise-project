<!DOCTYPE html>

<html lang="en">
<%~ include('./partials/admin.head.eta') %>

    <body>
        <!-- LOADING AREA START ===== -->
        <div class="loading-area">
            <div class="loading-box"></div>
            <div class="loading-pic">
                <div class="wrapper">
                    <div class="cssload-loader"></div>
                </div>
            </div>
        </div>
        <!-- LOADING AREA  END ====== -->

        <div class="page-wraper">
            <%~ include('./partials/admin.sidebar.eta') %>

                <!-- Page Content Holder -->
                <div id="content">
                    <div class="content-admin-main">
                        <!--Social Network-->
                       <form method="POST" action="/admin/site-config">
    <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
                            <div class="row">

                                <!-- ================= SITE BASIC INFO ================= -->
                                <!-- <div class="col-lg-6 col-md-6">
                                    <div class="form-group">
                                        <label>Site Name</label>
                                        <input class="form-control wt-form-control" name="siteName" type="text"
                                            placeholder="My Platform" value="<%= it.config?.siteName || '' %>">
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6">
                                    <div class="form-group">
                                        <label>Logo URL</label>
                                        <input class="form-control wt-form-control" name="logoUrl" type="text"
                                            placeholder="/assets/logo.png" value="<%= it.config?.logoUrl || '' %>">
                                    </div>
                                </div> -->

                                <!-- ================= SYSTEM SETTINGS ================= -->

                                <!-- <div class="col-lg-4 col-md-6">
                                    <div class="form-group">
                                        <label>Maintenance Mode</label>
                                        <select class="form-control wt-form-control" name="maintenanceMode">
                                            <option value="false" <%=!it.config?.maintenanceMode ? 'selected' : '' %>
                                                >Disabled</option>
                                            <option value="true" <%=it.config?.maintenanceMode ? 'selected' : '' %>
                                                >Enabled</option>
                                        </select>
                                    </div>
                                </div> -->

                                <div class="col-lg-6 col-md-6">
                                    <div class="form-group">
                                        <label>Registration</label>
                                        <select class="form-control wt-form-control" name="registrationEnabled">
                                            <option value="true" <%=it.config?.registration?.enabled ? 'selected' : ''
                                                %>>Enabled</option>
                                            <option value="false" <%=!it.config?.registration?.enabled ? 'selected' : ''
                                                %>>Disabled</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6">
                                    <div class="form-group">
                                        <label>Account Verification</label>
                                        <select class="form-control wt-form-control" name="verificationRequired">
                                            <option value="true" <%=it.config?.verification?.required ? 'selected' : ''
                                                %>>Required</option>
                                            <option value="false" <%=!it.config?.verification?.required ? 'selected'
                                                : '' %>>Not Required</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- ================= SOCIAL NETWORK ================= -->
                                <div class="col-12 mt-4">
                                    <h5>Social Networks</h5>
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <div class="form-group">
                                        <label>Facebook</label>
                                        <div class="ls-inputicon-box">
                                            <input class="form-control wt-form-control" name="facebook" type="text"
                                                placeholder="https://facebook.com/"
                                                value="<%= it.config?.socialLinks?.facebook || '' %>">
                                            <i class="fs-input-icon fab fa-facebook-f"></i>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <div class="form-group">
                                        <label>Twitter</label>
                                        <div class="ls-inputicon-box">
                                            <input class="form-control wt-form-control" name="twitter" type="text"
                                                placeholder="https://twitter.com/"
                                                value="<%= it.config?.socialLinks?.twitter || '' %>">
                                            <i class="fs-input-icon fab fa-twitter"></i>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <div class="form-group">
                                        <label>Instagram</label>
                                        <div class="ls-inputicon-box">
                                            <input class="form-control wt-form-control" name="instagram" type="text"
                                                placeholder="https://instagram.com/"
                                                value="<%= it.config?.socialLinks?.instagram || '' %>">
                                            <i class="fs-input-icon fab fa-instagram"></i>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <div class="form-group">
                                        <label>Youtube</label>
                                        <div class="ls-inputicon-box">
                                            <input class="form-control wt-form-control" name="youtube" type="text"
                                                placeholder="https://youtube.com/"
                                                value="<%= it.config?.socialLinks?.youtube || '' %>">
                                            <i class="fs-input-icon fab fa-youtube"></i>
                                        </div>
                                    </div>
                                </div>

                                <!-- ================= SUBMIT ================= -->
                                <div class="col-lg-12 col-md-12 mt-4">
                                    <div class="text-left">
                                        <button type="submit" class="site-button">
                                            Save Changes
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </form>
                    </div>

                </div>
        </div>

        <%~ include('./partials/admin.model.eta') %>

            <!--Logout Profile Popup-->
            <%~ include('./partials/admin.logout.model.eta') %>
                </div>

                <%~ include('./partials/admin.scripts.eta') %>
                    <script src="/js/admin-func.js"></script>
    </body>

</html>