<!DOCTYPE html>

<html lang="en">
  <%~ include('./partials/admin.head.eta') %>

  <body>
    <!-- LOADING AREA START ===== -->
    <div class="loading-area">
      <div class="loading-box"></div>
      <div class="loading-pic">
        <div class="wrapper">
          <div class="cssload-loader"></div>
        </div>
      </div>
    </div>
    <!-- LOADING AREA  END ====== -->

    <div class="page-wraper">
      <%~ include('./partials/admin.sidebar.eta') %>

      <!-- Page Content Holder -->
      <div id="content">
        <div class="content-admin-main">
          <div class="twm-dash-b-blocks mb-5">
            <div class="row">
              <div class="col-xl-3 col-lg-6 col-md-12 mb-3">
                <div class="panel panel-default">
                  <div class="panel-body wt-panel-body gradi-1 dashboard-card">
                    <div class="wt-card-wrap">
                      <div class="wt-card-icon"><i class="far fa-address-book"></i></div>
                      <div class="wt-card-right wt-total-active-listing counter"><%= it.stats.totalUsers %></div>
                      <div class="wt-card-bottom">
                        <h4 class="m-b0">Total Users</h4>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-xl-3 col-lg-6 col-md-12 mb-3">
                <div class="panel panel-default">
                  <div class="panel-body wt-panel-body gradi-2 dashboard-card">
                    <div class="wt-card-wrap">
                      <div class="wt-card-icon"><i class="far fa-file-alt"></i></div>
                      <div class="wt-card-right wt-total-listing-view counter"><%= it.stats.totalStartups %></div>
                      <div class="wt-card-bottom">
                        <h4 class="m-b0">Startups</h4>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-xl-3 col-lg-6 col-md-12 mb-3">
                <div class="panel panel-default">
                  <div class="panel-body wt-panel-body gradi-3 dashboard-card">
                    <div class="wt-card-wrap">
                      <div class="wt-card-icon"><i class="far fa-envelope"></i></div>
                      <div class="wt-card-right wt-total-listing-review counter"><%= it.stats.totalEnterprises %></div>
                      <div class="wt-card-bottom">
                        <h4 class="m-b0">Enterprises</h4>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-xl-3 col-lg-6 col-md-12 mb-3">
                <div class="panel panel-default">
                  <div class="panel-body wt-panel-body gradi-4 dashboard-card">
                    <div class="wt-card-wrap">
                      <div class="wt-card-icon"><i class="far fa-bell"></i></div>
                      <div class="wt-card-right wt-total-listing-bookmarked counter"><%= it.stats.totalJobs %></div>
                      <div class="wt-card-bottom">
                        <h4 class="m-b0">Total Jobs</h4>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="twm-pro-view-chart-wrap">
            <div class="row">
              <div class="col-xl-6 col-lg-12 col-md-12 mb-4">
                <div class="panel panel-default site-bg-white">
                  <div class="panel-heading wt-panel-heading p-a20">
                    <h4 class="panel-tittle m-a0"><i class="far fa-chart-bar"></i>Your Registrations by Months</h4>
                  </div>
                  <div class="panel-body wt-panel-body twm-pro-view-chart">
                    <canvas id="registrationsByMonthChart"></canvas>
                  </div>
                </div>
              </div>
              <div class="col-xl-6 col-lg-12 col-md-12 mb-4">
                <div class="panel panel-default site-bg-white">
                  <div class="panel-heading wt-panel-heading p-a20">
                    <h4 class="panel-tittle m-a0"><i class="far fa-chart-bar"></i>Your Jobs Posted by Months</h4>
                  </div>
                  <div class="panel-body wt-panel-body twm-pro-view-chart">
                    <canvas id="jobsByMonthChart"></canvas>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%~ include('./partials/admin.model.eta') %>

      <!--Logout Profile Popup-->
      <%~ include('./partials/admin.logout.model.eta') %>
    </div>

    <%~ include('./partials/admin.scripts.eta') %>
    <div
      id="dashboard-data"
      data-applications-by-months="<%= JSON.stringify(it.applicationsByMonth || []) %>"
      data-jobs-by-months="<%= JSON.stringify(it.jobsByMonth || []) %>"
      data-registrations-by-months="<%= JSON.stringify(it.registrationsByMonth || []) %>"
    ></div>
    <script src="/js/admin-dashboard.js"></script>
  </body>
</html>
